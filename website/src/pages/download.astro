---
import { Image } from 'astro:assets';
import signpath from '../assets/signpath.png';
import Base from '../layouts/Base.astro';
import { links } from '../links';
import { megabytes, release, type Download } from '../release';
import { requirements, steps } from '../site';

const released = release.date?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// ", 2.1 MB", or nothing for a link to the Releases page.
const size = (file: Download) => (file.size ? `, ${megabytes(file.size)}` : '');

// The site describes the version in CMakeLists.txt, which may not be out yet.
const note = release.upcoming
  ? `Unishade ${release.upcoming} isn't out yet, so this is ${release.version}${release.oldName ? ', from when Unishade was still called RobloxShadeHost' : ''}. Some of what the docs describe comes with ${release.upcoming}.`
  : release.oldName && `This release is from before the new name, so its files are still called RobloxShadeHost.`;

const others = [
  { name: 'macOS', file: release.macos, needs: requirements.macos },
  { name: 'Linux', file: release.linux, needs: requirements.linux },
];
---

<Base title="Download | Unishade" description="Download Unishade Setup for Windows 10 and 11, or Unishade for macOS and Linux.">
  <main class="download-page">
    <div class="top">
      <header>
        <h1>Download Unishade</h1>
        <p class="lede">Unishade, ReShade and every official effect in one installer. Depth estimation and DLSS5 are optional.</p>
      </header>

      <!-- Framed like Unishade's own windows. -->
      <section class="windows">
        <div class="windows-head">
          <h2>Windows</h2>
          <a class="button button-primary" href={release.setup.url}>
            {release.setup.name ? `Download Setup ${release.version}` : 'Download from GitHub Releases'}
          </a>
        </div>
        <dl>
          {
            release.version && (
              <div>
                <dt>Version</dt>
                <dd>
                  {release.version}, released {released}
                </dd>
              </div>
            )
          }
          {
            release.setup.name && (
              <div>
                <dt>File</dt>
                <dd>{release.setup.name}{size(release.setup)}. ReShade and the effects download during install.</dd>
              </div>
            )
          }
          <div>
            <dt>Needs</dt>
            <dd>{requirements.windows}</dd>
          </div>
        </dl>
        {note && <p>{note}</p>}
        <p class="dim">
          Setup isn't code-signed yet, so the first time Windows may say <strong>Windows protected your PC</strong>.{' '}
          Click <strong>More info</strong>, then <strong>Run anyway</strong>.
        </p>
        <p class="release-links">
          {
            release.version && (
              <>
                <a href={release.notes}>What's new in {release.version}</a> ·{' '}
              </>
            )
          }
          <a href={links.releases}>{release.version ? 'Older versions' : 'All versions'}</a>
        </p>
        <p class="signing dim">
          <Image src={signpath} alt="" width={28} layout="fixed" class="signing-logo" />
          <span>
            Free code signing provided by <a href={links.signpath}>SignPath.io</a>, certificate by{' '}
            <a href={links.signpathFoundation}>SignPath Foundation</a>. <a href="/code-signing/">Code signing policy</a>
          </span>
        </p>
      </section>
    </div>

    <section class="others">
      <h2 id="macos-and-linux">macOS and Linux (experimental)</h2>
      <p>
        ReShade only runs on Windows, so these run ReShade's effects themselves, with the same presets. They're new, so
        expect bugs.
      </p>
      <div class="platforms">
        {
          others.map(({ name, file, needs }) => (
            <div class="platform">
              <h3>{name}</h3>
              <p>
                {file ? (
                  <>
                    <a href={file.url}>Download for {name}</a> ({file.name}{size(file)})
                  </>
                ) : release.version ? (
                  <>
                    Not in {release.version} yet. Look on <a href={links.releases}>GitHub Releases</a>, or{' '}
                    <a href={links.build}>build it yourself</a>.
                  </>
                ) : (
                  <a href={links.releases}>Download from GitHub Releases</a>
                )}
              </p>
              <p class="dim">Needs {needs}.</p>
            </div>
          ))
        }
      </div>
      <a href="/docs/macos-linux/">How to set them up</a>
    </section>

    <section>
      <h2>After downloading</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>
      <a class="button button-secondary" href="/docs/">Read the install guide</a>
    </section>

    <section>
      <h2>Updating</h2>
      <p>
        Run the new Setup. Your presets, settings and games stay. Coming from RobloxShadeHost? Setup upgrades it the same
        way.
      </p>
    </section>

    <section>
      <h2>Without Setup</h2>
      <p>
        {
          release.host ? (
            <>
              <a href={release.host.url}>{release.host.name}</a> on its own ({megabytes(release.host.size ?? 0)}), if you'd rather install
              ReShade yourself.
            </>
          ) : (
            <>
              The program on its own is on <a href={links.releases}>GitHub Releases</a>, if you'd rather install ReShade
              yourself.
            </>
          )
        }{' '}
        The add-ons need Setup. <a href="/docs/#installing-without-setup">How to install it</a>
      </p>
    </section>
  </main>
</Base>

<style>
  .download-page {
    display: grid;
    gap: clamp(56px, 8vw, 96px);
    width: min(820px, 100% - 2 * var(--gutter));
    margin: clamp(40px, 7vw, 88px) auto 0;
  }

  .top {
    display: grid;
    gap: 36px;
  }

  header {
    display: grid;
    gap: 18px;
  }

  .lede {
    max-width: 50ch;
    color: var(--haze);
    font-size: 1.25rem;
  }

  section {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .windows {
    position: relative;
    padding: clamp(24px, 4vw, 40px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--night-raised);
    box-shadow: 0 40px 100px -50px rgb(84 110 255 / 0.5);
  }

  .windows::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--spectrum));
  }

  .windows-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    width: 100%;
  }

  dl {
    display: grid;
    gap: 10px;
    width: 100%;
    margin: 4px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  dl div {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 16px;
  }

  dt {
    color: var(--haze);
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .signing {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .signing-logo {
    flex: none;
    width: 28px;
    height: auto;
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
  }

  .platform {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .platform .dim {
    font-size: 0.95rem;
  }

  ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 1.4em;
  }

  li::marker {
    color: var(--accent);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .platforms {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
