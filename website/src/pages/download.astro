---
import { Image } from 'astro:assets';
import signpath from '../assets/signpath.png';
import Base from '../layouts/Base.astro';
import { links } from '../links';
import { megabytes, release, type Download } from '../release';
import { requirements, steps } from '../site';

const released = release.date?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// ", 2.1 MB", or nothing for a link to the Releases page.
const size = (file: Download | undefined) => (file?.size ? `, ${megabytes(file.size)}` : '');

// The site describes the version in CMakeLists.txt, which may not be out yet.
const note = release.upcoming
  ? `Unishade ${release.upcoming} isn't out yet, so this is ${release.version}${release.oldName ? ', from when Unishade was still called RobloxShadeHost' : ''}. Some of what the docs describe comes with ${release.upcoming}.`
  : release.oldName && `This release is from before the new name, so its files are still called RobloxShadeHost.`;

// Each system in one of the ring's colors, like the home page's bands.
const platforms = [
  {
    id: 'windows',
    name: 'Windows',
    file: release.setup.name ? release.setup : undefined,
    needs: requirements.windows,
    guide: '/docs/#windows',
  },
  { id: 'macos', name: 'macOS', file: release.macos, needs: requirements.macos, guide: '/docs/#macos' },
  { id: 'linux', name: 'Linux', file: release.linux, needs: requirements.linux, guide: '/docs/#linux' },
];
---

<Base title="Download | Unishade" description="Download Unishade for Windows, macOS and Linux.">
  <main class="download-page">
    <header>
      <h1>Download Unishade</h1>
      <p class="lede">
        {
          release.version ? (
            <>
              Version {release.version}, released {released}. <a href={release.notes}>What's new</a>
            </>
          ) : (
            <>Free and open source, for Windows, macOS and Linux.</>
          )
        }
      </p>
      {note && <p class="note">{note}</p>}
    </header>

    <ul class="platforms">
      {
        platforms.map(({ id, name, file, needs, guide }) => (
          <li class="platform" id={id}>
            <h2>{name}</h2>
            <p>Needs {needs}.</p>
            {file ? (
              <a class="button" href={file.url}>
                Download for {name}
              </a>
            ) : release.version ? (
              <a class="button" href={links.releases}>
                Look on GitHub Releases
              </a>
            ) : (
              <a class="button" href={links.releases}>
                Download from GitHub Releases
              </a>
            )}
            <p class="file">
              {file ? (
                <>
                  {file.name}
                  {size(file)}
                </>
              ) : (
                release.version && (
                  <>
                    Not in {release.version} yet. You can also <a href={links.build}>build it yourself</a>.
                  </>
                )
              )}
            </p>
            <a class="guide" href={guide}>
              How to install it
            </a>
          </li>
        ))
      }
    </ul>

    <section>
      <h2>After installing</h2>
      <ol>
        {steps.map((step) => <li>{step}</li>)}
      </ol>
      <a class="button button-secondary" href="/docs/">Read the install guide</a>
    </section>

    <section>
      <h2>Updating</h2>
      <p>
        Install the new version over the old one. Your presets, settings and games stay. Coming from RobloxShadeHost? Setup upgrades it
        the same way.
      </p>
      <p><a href={links.releases}>{release.version ? 'Older versions' : 'All versions'}</a></p>
    </section>

    {
      release.host && (
        <section>
          <h2>Windows without Setup</h2>
          <p>
            <a href={release.host.url}>{release.host.name}</a> on its own ({megabytes(release.host.size ?? 0)}).{' '}
            <a href="/docs/#windows-without-setup">How to install it</a>
          </p>
        </section>
      )
    }

    <section>
      <h2>Code signing</h2>
      <p>
        Setup isn't code-signed yet, so the first time Windows may say <strong>Windows protected your PC</strong>. Click{' '}
        <strong>More info</strong>, then <strong>Run anyway</strong>.
      </p>
      <p class="signing dim">
        <Image src={signpath} alt="" width={28} layout="fixed" class="signing-logo" />
        <span>
          Free code signing provided by <a href={links.signpath}>SignPath.io</a>, certificate by{' '}
          <a href={links.signpathFoundation}>SignPath Foundation</a>. <a href="/code-signing/">Code signing policy</a>
        </span>
      </p>
    </section>
  </main>
</Base>

<style>
  .download-page {
    display: grid;
    gap: clamp(56px, 8vw, 96px);
    width: var(--page);
    margin: clamp(40px, 7vw, 88px) auto 0;
  }

  header {
    display: grid;
    gap: 18px;
  }

  .lede {
    color: var(--haze);
    font-size: 1.25rem;
  }

  .note {
    max-width: 60ch;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: var(--night-raised);
  }

  /* Three tiles in the ring's colors, as the effects are in the menu. */
  .platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platform {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 14px;
    padding: clamp(22px, 2.6vw, 34px);
    border-radius: var(--block);
    color: #000;
    font-weight: 600;
    scroll-margin-top: calc(var(--nav-height) + 16px);
  }

  .platform:nth-child(1) {
    background: var(--cyan);
  }

  .platform:nth-child(2) {
    background: var(--yellow);
  }

  .platform:nth-child(3) {
    background: var(--green);
  }

  .platform h2 {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
  }

  .platform > p:first-of-type {
    min-height: 4.6em;
  }

  .platform .button {
    color: #fff;
    background: #000;
  }

  .platform .button:hover {
    background: #2a2a33;
  }

  .platform a:not(.button) {
    color: inherit;
  }

  .file {
    min-height: 1.5em;
    font-size: 0.92rem;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  section {
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 68ch;
  }

  section h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .signing {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
  }

  .signing-logo {
    flex: none;
    width: 28px;
    height: auto;
  }

  ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 1.4em;
  }

  li::marker {
    color: var(--haze);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .platforms {
      grid-template-columns: minmax(0, 1fr);
    }

    .platform > p:first-of-type {
      min-height: 0;
    }
  }
</style>
