---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import { links } from '../links';
import { videos } from '../videos';
import logo from '../../../assets/UnishadeSmall.png';
import GithubIcon from '../icons/github.svg';

const [featured, ...more] = videos;
---

<Base
  title="Unishade | Universal post-processing without injection."
  description="ReShade effects without injecting anything into your game. Free and open source."
  overlay
>
  <main>
    <Hero />

    <Steps />

    <section class="videos">
      <div class="videos-text">
        <h2>Seen on YouTube</h2>
        <p class="dim">Creators trying DLSS5 in Greenville, Driving Empire and other Roblox games.</p>
      </div>
      <a class="video featured" href={featured.url}>
        <Image src={featured.thumbnail} widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 60vw" alt="" class="thumb" />
        <span class="video-title">{featured.title}</span>
        <span class="dim">{featured.channel}</span>
      </a>
      <ul class="video-grid">
        {
          more.map((video) => (
            <li>
              <a class="video" href={video.url}>
                <Image src={video.thumbnail} widths={[320, 640]} sizes="(max-width: 600px) 100vw, 240px" alt="" class="thumb" />
                <span class="video-title">{video.title}</span>
                <span class="dim">{video.channel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="closing">
      <Image src={logo} widths={[360, 720]} sizes="360px" alt="" class="closing-logo" />
      <h2>Free and open source</h2>
      <DownloadButton>
        <a class="button button-secondary" href={links.github}><GithubIcon aria-hidden="true" />View on GitHub</a>
      </DownloadButton>
    </section>
  </main>
</Base>

<style>
  .videos {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px clamp(32px, 5vw, 64px);
    align-items: end;
    width: var(--page);
    margin: clamp(96px, 13vw, 180px) auto 0;
  }

  .videos-text {
    display: grid;
    gap: 16px;
    align-self: center;
    max-width: 30ch;
  }

  .video-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 32px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .video {
    display: grid;
    gap: 4px;
    align-content: start;
    color: var(--ink);
    text-decoration: none;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 10px;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition:
      transform 0.35s var(--ease-out),
      border-color 0.2s;
  }

  .video-title {
    font-weight: 650;
    line-height: 1.35;
  }

  .featured .video-title {
    font-size: 1.3rem;
    font-stretch: 112%;
  }

  .video .dim {
    font-size: 0.9rem;
  }

  .video:hover {
    color: var(--accent);
  }

  .video:hover .thumb {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }

  .closing {
    display: grid;
    justify-items: center;
    gap: 18px;
    width: var(--page);
    margin: clamp(120px, 16vw, 220px) auto 0;
    text-align: center;
  }

  .closing-logo {
    width: min(320px, 70vw);
    margin-bottom: 12px;
  }

  .closing :global(.download) {
    justify-content: center;
    margin-top: 10px;
  }

  /* The version and size go on their own line, under both buttons. */
  .closing :global(.download > .dim) {
    flex-basis: 100%;
  }

  .closing .button svg {
    width: 20px;
    height: 20px;
    margin-right: 10px;
  }

  @media (max-width: 900px) {
    .videos {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transition: none;
    }

    .video:hover .thumb {
      transform: none;
    }
  }
</style>
