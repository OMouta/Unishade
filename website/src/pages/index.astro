---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import { links } from '../links';
import { videos } from '../videos';
import logo from '../../../assets/UnishadeSmall.png';
import GithubIcon from '../icons/github.svg';

const [featured, ...more] = videos;
---

<Base
  title="Unishade | Universal post-processing without injection."
  description="ReShade effects without injecting anything into your game. Free and open source."
  overlay
>
  <main>
    <Hero />

    <Steps />

    <section class="videos">
      <div class="videos-text">
        <h2>Seen on YouTube</h2>
        <p class="dim">Creators trying DLSS5 in Greenville, Driving Empire and other Roblox games.</p>
      </div>
      <a class="video featured" href={featured.url}>
        <Image src={featured.thumbnail} widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 600px" alt="" class="thumb" />
        <span class="video-title">{featured.title}</span>
        <span class="dim">{featured.channel}</span>
      </a>
      <ul class="video-grid">
        {
          more.map((video) => (
            <li>
              <a class="video" href={video.url}>
                <Image src={video.thumbnail} widths={[320, 640]} sizes="(max-width: 900px) 50vw, 290px" alt="" class="thumb" />
                <span class="video-title">{video.title}</span>
                <span class="dim">{video.channel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="closing">
      <Image src={logo} widths={[460, 920]} sizes="(max-width: 600px) 78vw, 460px" alt="" class="closing-logo" />
      <h2>Free and open source</h2>
      <DownloadButton>
        <a class="button button-secondary" href={links.github}><GithubIcon aria-hidden="true" />View on GitHub</a>
      </DownloadButton>
    </section>
  </main>
</Base>

<style>
  /* The first video is four times the size of the rest, with the heading beside it. */
  .videos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px 24px;
    width: var(--page);
    margin: clamp(96px, 13vw, 180px) auto 0;
  }

  .videos-text {
    grid-column: 3 / span 2;
    display: grid;
    gap: 16px;
    align-self: center;
    max-width: 30ch;
    padding-left: clamp(0px, 2vw, 28px);
  }

  .featured {
    grid-area: 1 / 1 / span 2 / span 2;
  }

  .video-grid,
  .video-grid li {
    display: contents;
  }

  .video {
    display: grid;
    gap: 4px;
    align-content: start;
    color: var(--ink);
    text-decoration: none;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 10px;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition:
      transform 0.35s var(--ease-out),
      border-color 0.2s;
  }

  .video-title {
    font-weight: 650;
    line-height: 1.35;
  }

  .featured .video-title {
    font-size: 1.3rem;
    font-stretch: 112%;
  }

  .video .dim {
    font-size: 0.9rem;
  }

  .video:hover {
    color: var(--accent);
  }

  .video:hover .thumb {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }

  .closing {
    display: grid;
    justify-items: center;
    gap: 18px;
    width: var(--page);
    margin: clamp(120px, 16vw, 220px) auto 0;
    text-align: center;
  }

  .closing h2 {
    font-size: clamp(2.2rem, 6vw, 5.4rem);
    font-weight: 860;
    line-height: 0.94;
    letter-spacing: -0.04em;
  }

  .closing-logo {
    width: min(460px, 78vw);
    margin-bottom: 12px;
  }

  .closing :global(.download) {
    justify-content: center;
    margin-top: 10px;
  }

  /* The version and size go on their own line, under both buttons. */
  .closing :global(.download > .dim) {
    flex-basis: 100%;
  }

  .closing .button svg {
    width: 20px;
    height: 20px;
    margin-right: 10px;
  }

  @media (max-width: 900px) {
    .videos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .videos-text,
    .featured {
      grid-area: auto / 1 / auto / -1;
    }

    .videos-text {
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transition: none;
    }

    .video:hover .thumb {
      transform: none;
    }
  }
</style>
