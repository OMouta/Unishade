---
// Seven bands in the ring's seven colors, each a tile as big as the window that slides over the one before it. Big
// type below, and a picture of the game or the app above it.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import before from '../assets/shots/game-before.jpg';
import after from '../assets/shots/game-after.jpg';
import dusk from '../assets/shots/game-after-1.jpg';
import found from '../assets/shots/crop-found.png';
import menu from '../assets/shots/menu.jpg';
import menuPresets from '../assets/shots/menu-presets.jpg';
import addons from '../assets/shots/crop-addons.png';
import { inBeta, release } from '../release';
import { requirements } from '../site';

// The bands, for the dots at the side that say which one shows.
const sections = [
  ['red', 'Nothing goes into the game'],
  ['orange', 'Pick your games once'],
  ['yellow', 'Change it while you play'],
  ['green', 'A preset for every game'],
  ['cyan', 'Hold to compare'],
  ['blue', 'Add-ons'],
  ['violet', 'Download'],
];

// The panes over the game in the hero, from the bottom one up. Each has one of the ring's colors, and the name of an
// effect from presets/GenericPreset2.ini on a tab like the menu's tiles.
const panes = [
  ['red', 'Adaptive Tonemapper'],
  ['orange', 'NeoBloom'],
  ['yellow', 'ArcaneBloom'],
  ['green', 'Curves'],
  ['cyan', 'HDR'],
  ['blue', 'AmbientLight'],
  ['violet', 'Colourfulness'],
];

// When the newest release has no file for a system, its button goes to the download page, which says why.
const platforms = [
  { name: 'Windows', needs: requirements.windowsShort, href: release.setup.name ? release.setup.url : '/download/' },
  { name: 'macOS', needs: requirements.macosShort, href: release.macos?.url ?? '/download/#macos' },
  { name: 'Linux', needs: requirements.linuxShort, href: release.linux?.url ?? '/download/#linux' },
];
---

<Base
  title="Unishade | Universal post-processing without injection."
  description="ReShade effects over your game without injecting anything into it. Free and open source, for Windows, macOS and Linux."
  overlay
>
  <header class="top">
    <div class="scene" aria-hidden="true">
      <div class="tilt">
        <div class="plane floor spectrum"></div>
        <div class="plane game">
          <Image src={before} widths={[640, 960, 1440]} sizes="(max-width: 800px) 92vw, 57vw" alt="" priority />
          <Image src={after} widths={[640, 960, 1440]} sizes="(max-width: 800px) 92vw, 57vw" alt="" class="graded" loading="eager" />
          <div class="sweep"></div>
        </div>
        {
          panes.map(([color, effect]) => (
            <div class:list={['plane', 'pane', color]}>
              <span class="tab">{effect}</span>
            </div>
          ))
        }
        <div class="plane halo glow spectrum"></div>
        <div class="plane halo spectrum"></div>
      </div>
    </div>

    <div class="pitch">
      <h1>Universal <span>post-processing</span> without injection.</h1>
      <a class="button button-primary" href="/download/">Download</a>
    </div>
  </header>

  <main>
    <section class="band red" id="red">
      <Image src={after} widths={[960, 1440, 1920]} sizes="92vw" alt="A game with Unishade's effects" class="shot photo" />
      <h2>Nothing goes into the game.</h2>
      <p>Unishade draws effects on top of it instead.</p>
    </section>

    <section class="band orange" id="orange">
      <div class="shot photo stage">
        <Image src={found} widths={[480, found.width]} sizes={`(max-width: 800px) 84vw, ${found.width}px`} alt="Unishade listing the games it found" class="front" />
        {inBeta && <span class="beta-tag">Beta</span>}
      </div>
      <h2>Pick your games once.</h2>
      <p>After that, just open the game.</p>
    </section>

    <section class="band yellow" id="yellow">
      <div class="shot photo frame">
        <Image src={menu} widths={[960, 1440, 1920]} sizes="92vw" alt="Unishade's menu over a game: the preset's effects as colored tiles, with the preset's name and buttons under them" />
        {inBeta && <span class="beta-tag">Beta</span>}
      </div>
      <h2>Change it while you play.</h2>
      <p>The menu opens over the game, one tile per effect.</p>
    </section>

    <section class="band green" id="green">
      <div class="shot photo frame">
        <Image src={menuPresets} widths={[960, 1440, 1920]} sizes="92vw" alt="The menu's list of presets over a game" />
        {inBeta && <span class="beta-tag">Beta</span>}
      </div>
      <h2>A preset for every game.</h2>
      <p>Every game keeps the look you gave it.</p>
    </section>

    <section class="band cyan" id="cyan">
      <div class="shot photo split">
        <Image src={before} widths={[960, 1440, 1920]} sizes="92vw" alt="The game without effects" />
        <Image src={after} widths={[960, 1440, 1920]} sizes="92vw" alt="The same view with effects" />
      </div>
      <h2>Hold to compare.</h2>
      <p>See what your effects change.</p>
    </section>

    <section class="band blue" id="blue">
      <div class="shot photo stage">
        <Image src={after} widths={[960, 1440, 1920]} sizes="92vw" alt="" class="back dim" />
        <Image src={addons} widths={[480, addons.width]} sizes={`(max-width: 800px) 84vw, ${addons.width}px`} alt="The Add-ons window, with its add-ons turned on" class="front" />
        {inBeta && <span class="beta-tag">Beta</span>}
      </div>
      <h2>Extend it with add-ons.</h2>
      <p>For when effects alone aren't enough.</p>
    </section>

    <section class="band violet" id="violet">
      <Image src={dusk} widths={[960, 1440, 1920]} sizes="92vw" alt="A game with another preset's effects" class="shot photo" />
      <h2>Windows, macOS, Linux.</h2>
      <ul>
        {
          platforms.map((platform) => (
            <li>
              <a href={platform.href}>
                <strong>Download for {platform.name}</strong>
                <span>{platform.needs}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <nav class="rail" aria-label="Sections">
    {
      sections.map(([id, label]) => (
        <a href={`#${id}`} aria-label={label}>
          <i />
        </a>
      ))
    }
  </nav>

</Base>

<script>
  // The dots at the side: which band shows, and how far through it the scrolling is. A band holds still for a
  // while, so the dot filling up is what says the page still follows the wheel.
  const bands = [...document.querySelectorAll<HTMLElement>('.band')];
  const rail = document.querySelector<HTMLElement>('.rail')!;
  const dots = [...rail.querySelectorAll<HTMLAnchorElement>('a')];
  let starts: number[] = [];
  let holds: number[] = [];

  // Where each band reaches the top of the window, and how much scrolling it then stays for.
  const measure = () => {
    let top = bands[0].parentElement!.getBoundingClientRect().top + scrollY;
    starts = [];
    holds = [];
    for (const band of bands) {
      const hold = parseFloat(getComputedStyle(band).marginBottom) || 0;
      starts.push(top);
      holds.push(hold);
      top += band.offsetHeight + hold;
    }
  };

  const update = () => {
    const stacked = getComputedStyle(bands[0]).position === 'sticky';
    let current = -1;
    starts.forEach((start, index) => {
      if (scrollY >= start - innerHeight / 2) current = index;
    });
    const past = scrollY > starts[starts.length - 1] + innerHeight * 0.6;
    rail.classList.toggle('shown', stacked && current >= 0 && !past);
    dots.forEach((dot, index) => {
      if (index === current) dot.setAttribute('aria-current', 'true');
      else dot.removeAttribute('aria-current');
      const through = index < current ? 1 : index > current ? 0 : holds[index] ? (scrollY - starts[index]) / holds[index] : 1;
      dot.style.setProperty('--through', `${Math.min(Math.max(through, 0), 1) * 100}%`);
    });
  };

  // A band that is stuck at the top is already in view to the browser, so the dots scroll to where it starts.
  dots.forEach((dot, index) =>
    dot.addEventListener('click', (event) => {
      event.preventDefault();
      scrollTo({ top: starts[index], behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }),
  );

  const refresh = () => {
    measure();
    update();
  };
  refresh();
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', refresh);
  addEventListener('load', refresh);
</script>

<script>
  // The hero: the panes lift off the game, land on it again one by one, and close into a ring. With less motion asked
  // for, they stay as the styles leave them, which is down.
  const hero = document.querySelector<HTMLElement>('.top')!;
  const tilt = hero.querySelector<HTMLElement>('.tilt')!;
  const game = hero.querySelector<HTMLElement>('.game')!;
  const panes = [...hero.querySelectorAll<HTMLElement>('.pane')];
  const colors = panes.map((pane) => getComputedStyle(pane).getPropertyValue('--color'));

  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const smooth = (x: number) => clamp(x) * clamp(x) * (3 - 2 * clamp(x));
  const mix = (from: number, to: number, x: number) => from + (to - from) * x;

  // Seconds. The first pane starts to fall at firstFall, each next one a gap later, and they all lift at liftOff.
  // The page opens just before that, with every pane down, which is also how it looks before this script runs.
  const loop = 13;
  const firstFall = 0.9;
  const gap = 0.46;
  const fallTime = 0.7;
  const landing = 0.42;
  const liftOff = 9.3;
  const opening = 7.4;

  // Where the pointer is over the hero, which turns the stack a little towards it.
  let pointerX = 0.5;
  let pointerY = 0.5;
  let turnX = 0.5;
  let turnY = 0.5;
  hero.addEventListener('pointermove', (event) => {
    if (event.pointerType !== 'mouse') return;
    const box = hero.getBoundingClientRect();
    pointerX = (event.clientX - box.left) / box.width;
    pointerY = (event.clientY - box.top) / box.height;
  });
  hero.addEventListener('pointerleave', () => {
    pointerX = 0.5;
    pointerY = 0.5;
  });

  const draw = (time: number, step: number) => {
    const now = time % loop;
    let grade = 0;
    let lifted = 0;
    let crossing = -1;
    panes.forEach((pane, index) => {
      const up = 3.2 + index * 2;
      const down = 0.5 + index * 0.5;
      const start = firstFall + index * gap;
      const x = clamp((now - start) / fallTime);
      // It speeds up as it falls, and gives a little when it lands.
      const fall = x < 0.6 ? (x / 0.6) ** 2 : 1 - 0.05 * Math.sin(((x - 0.6) / 0.4) * Math.PI) * (1 - (x - 0.6) / 0.4);
      // The top pane lifts first.
      const lift = smooth((now - liftOff - (panes.length - 1 - index) * 0.13) / 1.2);
      const landed = now - start - landing;
      lifted = Math.max(lifted, lift);
      pane.style.setProperty('--z', mix(mix(up, down, fall), up, lift).toFixed(3));
      pane.style.setProperty('--flash', (landed > 0 ? Math.exp(-landed * 5) * (1 - lift) : 0).toFixed(3));
      // Each pane takes the picture one step from the game as it is to the game with effects.
      grade += smooth(landed / 0.5) * (1 - lift);
      if (landed > 0 && landed < 0.6) crossing = index;
    });
    game.style.setProperty('--grade', (grade / panes.length).toFixed(3));
    if (crossing < 0) {
      game.style.setProperty('--light', '0');
    } else {
      const x = (now - firstFall - crossing * gap - landing) / 0.6;
      game.style.setProperty('--landed', colors[crossing]);
      game.style.setProperty('--across', `${mix(-75, 75, x).toFixed(1)}%`);
      game.style.setProperty('--light', (Math.sin(x * Math.PI) * 0.5).toFixed(3));
    }
    // The ring closes once the last pane is down, and opens as the panes lift.
    const closed = smooth((now - firstFall - (panes.length - 1) * gap - 0.5) / fallTime) * (1 - smooth(lifted * 3));
    tilt.style.setProperty('--ring', closed.toFixed(3));
    tilt.style.setProperty('--turn', `${((time * 50) % 360).toFixed(1)}deg`);
    turnX += (pointerX - turnX) * Math.min(1, step * 3);
    turnY += (pointerY - turnY) * Math.min(1, step * 3);
    tilt.style.setProperty('--rx', `${(58 - (turnY - 0.5) * 10 + Math.sin(time * 0.4) * 1.2).toFixed(2)}deg`);
    tilt.style.setProperty('--rz', `${(-31 + (turnX - 0.5) * 16 + Math.sin(time * 0.27) * 2).toFixed(2)}deg`);
  };

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const started = performance.now();
    let previous = started;
    let frame = 0;
    const tick = (at: number) => {
      draw((at - started) / 1000 + opening, Math.min((at - previous) / 1000, 0.05));
      previous = at;
      frame = requestAnimationFrame(tick);
    };
    // Nothing moves while the hero is scrolled out of the window.
    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(frame);
      if (entry.isIntersecting) frame = requestAnimationFrame(tick);
    }).observe(hero);
  }
</script>

<style>
  .top {
    --side: var(--gutter);
    position: relative;
    display: grid;
    min-height: 100svh;
    padding: var(--nav-height) var(--side) clamp(28px, 5vw, 64px);
    overflow: hidden;
  }

  /* The game lying flat, with a pane over it for each effect. Its sizes are in em, so one font size scales all of it.
     It fades out to the left, where the headline is. */
  .scene {
    position: absolute;
    inset: 0;
    font-size: min(1vw, 19px);
    perspective: 200em;
    perspective-origin: 70% 40%;
    mask-image: linear-gradient(72deg, transparent 22%, #000 56%);
    animation: arrive 1.4s var(--ease-out) backwards;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  .tilt {
    position: absolute;
    top: 53%;
    left: 69%;
    transform: rotateX(var(--rx, 58deg)) rotateZ(var(--rz, -31deg));
    transform-style: preserve-3d;
  }

  /* Without the script, and for those who asked for less motion, the panes lie on the game and the ring is closed.
     The script moves them by setting how high each is, in em. */
  .plane {
    position: absolute;
    top: -16em;
    left: -28.5em;
    width: 57em;
    height: 32em;
    border-radius: 1.9em;
    transform: translateZ(calc(var(--z, 0) * 1em));
  }

  .spectrum {
    background: conic-gradient(from var(--turn, 0deg), var(--spectrum), var(--red));
  }

  /* The ring's glow, on the floor under the game. */
  .floor {
    --z: -1.2;
    top: -20em;
    left: -32.25em;
    width: 64.5em;
    height: 40em;
    border-radius: 5.6em;
    opacity: calc(0.16 + var(--ring, 1) * 0.5);
    filter: blur(4.4em);
  }

  .game {
    overflow: hidden;
    background: var(--night-raised);
  }

  /* A little bigger than the plane, which leaves the game's own buttons outside it. */
  .game img {
    position: absolute;
    top: -12%;
    left: -6%;
    width: 112%;
    max-width: none;
    height: 112%;
    object-fit: cover;
  }

  .game .graded {
    opacity: var(--grade, 1);
  }

  /* Light that crosses the game as a pane lands, in the pane's color. */
  .sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, color-mix(in srgb, var(--landed, #fff) 65%, #fff) 50%, transparent 70%);
    opacity: var(--light, 0);
    translate: var(--across, -100%) 0;
    mix-blend-mode: screen;
  }

  .pane {
    --z: calc(0.5 + var(--i) * 0.5);
    border: 0.19em solid var(--color);
    background: linear-gradient(155deg, color-mix(in srgb, var(--color) 13%, transparent), color-mix(in srgb, var(--color) 2%, transparent) 55%);
    box-shadow:
      0 0 2.1em color-mix(in srgb, var(--color) 55%, transparent),
      inset 0 0 3.7em color-mix(in srgb, var(--color) 20%, transparent),
      inset 0 0 0 1px rgb(255 255 255 / 0.28);
    transform-style: preserve-3d;
  }

  .pane.red {
    --i: 0;
  }

  .pane.orange {
    --i: 1;
  }

  .pane.yellow {
    --i: 2;
  }

  .pane.green {
    --i: 3;
  }

  .pane.cyan {
    --i: 4;
  }

  .pane.blue {
    --i: 5;
  }

  .pane.violet {
    --i: 6;
  }

  /* The underside of the pane, which gives it its thickness. */
  .pane::before {
    content: '';
    position: absolute;
    inset: -0.19em;
    border: 0.19em solid color-mix(in srgb, var(--color) 50%, #000);
    border-radius: inherit;
    transform: translateZ(-0.43em);
  }

  /* The flash as it lands. */
  .pane::after {
    content: '';
    position: absolute;
    inset: -0.19em;
    border: 0.25em solid #fff;
    border-radius: inherit;
    box-shadow:
      0 0 5em 0.75em var(--color),
      inset 0 0 5em var(--color);
    opacity: var(--flash, 0);
  }

  /* The effect's name, on a tab like its tile in the menu. Each pane's tab is further along its top edge than the
     one below, so all seven show when the panes are down. */
  .tab {
    position: absolute;
    bottom: 100%;
    left: calc(1.75em + var(--i) * 7.7em);
    display: flex;
    align-items: flex-end;
    width: 7.3em;
    height: 5em;
    margin-bottom: 0.12em;
    padding: 0.55em 0.5em;
    border-radius: 1.1em 1.1em 0 0;
    color: #000;
    background: var(--color);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* The switch a tile has in its corner. */
  .tab::after {
    content: '';
    position: absolute;
    top: 0.56em;
    right: 0.62em;
    width: 1em;
    height: 1em;
    border: 0.28em solid #000;
    border-radius: 50%;
  }

  /* When every pane is down they close into one ring, as the logo's is. The mask leaves only the border. */
  .halo {
    --z: 4.25;
    padding: 0.37em;
    opacity: var(--ring, 1);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  .halo.glow {
    padding: 1em;
    filter: blur(1em);
  }

  .pitch {
    position: relative;
    display: grid;
    gap: clamp(16px, 2vw, 26px);
    align-self: end;
  }

  .pitch h1 {
    max-width: 9.5em;
    font-size: clamp(2.3rem, 10.4vw, 10rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .pitch h1 span {
    white-space: nowrap;
  }

  .pitch .button {
    justify-self: start;
  }

  /* Each band stays at the top of the window while the next slides over it. The space under it is scrolling that
     leaves the band as it is, so there is time to read it before the next one arrives. */
  .band {
    margin-bottom: 70svh;
    --side: var(--gutter);
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    align-items: end;
    gap: 28px clamp(28px, 5vw, 80px);
    min-height: 100svh;
    padding: clamp(18px, 2.4vw, 32px) var(--side) clamp(32px, 4.4vw, 60px);
    border-radius: 35px 35px 0 0;
    color: #000;
    background: var(--color);
  }

  .band a {
    color: inherit;
  }

  .band:last-child {
    margin-bottom: 0;
  }

  .red {
    --color: var(--red);
  }

  .orange {
    --color: var(--orange);
  }

  .yellow {
    --color: var(--yellow);
  }

  .green {
    --color: var(--green);
  }

  .cyan {
    --color: var(--cyan);
  }

  .blue {
    --color: var(--blue);
  }

  .violet {
    --color: var(--violet);
  }

  .band h2 {
    font-size: clamp(2.7rem, 7.4vw, 7.4rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }

  .band p {
    max-width: 24em;
    padding-bottom: 0.5em;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
  }

  /* The game, as wide as the band. */
  .shot.photo {
    grid-column: 1 / -1;
    align-self: center;
    width: 100%;
    height: min(58svh, 680px);
    border-radius: 28px;
    box-shadow: 0 30px 70px rgb(0 0 0 / 0.35);
    object-fit: cover;
  }

  /* The game with the menu over it, in a box whose corner can hold the beta tag. The menu sits at the bottom of the
     game, so that is the part to keep. */
  .frame {
    position: relative;
    overflow: hidden;
  }

  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  /* While the version in the pictures is in beta, the ones that show the app say so. */
  .shot .beta-tag {
    position: absolute;
    top: 18px;
    left: 18px;
  }

  /* A piece of the app over the game, as the menu is. The piece keeps the size it has on screen, so its words stay
     sharp, and the game behind it fills the band. */
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #000;
  }

  .stage .back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage .back.dim {
    filter: brightness(0.55) blur(6px);
    scale: 1.04;
  }

  .stage .front {
    position: relative;
    width: auto;
    max-width: calc(100% - 32px);
    height: auto;
    max-height: calc(min(58svh, 680px) - 48px);
    margin: 24px 16px;
    border-radius: 35px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.55);
  }

  /* Without effects on the left, with them on the right. */
  .split {
    position: relative;
    overflow: hidden;
  }

  .split img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split img:last-child {
    clip-path: inset(0 0 0 50%);
  }

  .split::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 50%;
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
  }

  .violet ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .violet li a {
    display: grid;
    gap: 2px;
    padding: 16px 20px;
    border-radius: 18px;
    color: #fff;
    background: #000;
    text-decoration: none;
    transition: translate 0.4s var(--spring);
  }

  .violet li a:hover {
    translate: 6px 0;
  }

  .violet strong {
    font-weight: 800;
    font-size: 1.25rem;
  }

  .violet span {
    color: var(--haze);
  }

  /* One dot for each band. The one that shows is longer, and fills as the scrolling goes through it. */
