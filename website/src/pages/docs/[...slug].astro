---
import { getCollection, type CollectionEntry } from 'astro:content';
import Guide from '../../layouts/Guide.astro';

export async function getStaticPaths() {
  const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return pages.map((entry) => ({ params: { slug: entry.id === 'install' ? undefined : entry.id }, props: { entry, pages } }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
  pages: CollectionEntry<'docs'>[];
}

const { entry, pages } = Astro.props;
---

<Guide entry={entry} pages={pages} root="/docs/" home="install" label="Docs" source="website/src/content/docs" />
