---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return pages.map((entry) => ({ params: { slug: entry.id === 'install' ? undefined : entry.id }, props: { entry, pages } }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
  pages: CollectionEntry<'docs'>[];
}

const { entry, pages } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const href = (id: string) => (id === 'install' ? '/docs/' : `/docs/${id}/`);
const index = pages.indexOf(entry);
const previous = pages[index - 1];
const next = pages[index + 1];
// Each page takes a color of the ring, in the sidebar's order, as each effect's tile does in the menu.
const tones = ['red', 'orange', 'yellow', 'green', 'cyan', 'blue', 'violet'];
const tone = (page: CollectionEntry<'docs'>) => tones[pages.indexOf(page) % tones.length];
---

<Base title={`${entry.data.title} | Unishade`} description={entry.data.description}>
  <div class="docs">
    <header class="cover" data-tone={tone(entry)}>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
    </header>

    <nav class="sidebar" aria-label="Docs">
      <ul>
        {
          pages.map((page) => (
            <li data-tone={tone(page)}>
              <a href={href(page.id)} aria-current={page === entry ? 'page' : undefined}>
                {page.data.title}
              </a>
              {page === entry && sections.length > 0 && (
                <ul class="sections">
                  {sections.map((section) => (
                    <li>
                      <a href={`#${section.slug}`}>{section.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <main class="guide">
      <div class="prose">
        <Content />
      </div>
      {
        (previous || next) && (
          <nav class="pager" aria-label="Previous and next page">
            {previous && (
              <a class="previous" href={href(previous.id)}>
                <span>Previous</span>
                {previous.data.title}
              </a>
            )}
            {next && (
              <a class="next" href={href(next.id)} data-tone={tone(next)}>
                <span>Next</span>
                {next.data.title}
              </a>
            )}
          </nav>
        )
      }
    </main>
  </div>
</Base>

<script>
  // Marks the section being read in the sidebar.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.sections a')].map((link) => [decodeURIComponent(link.hash.slice(1)), link]),
  );
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')].filter((heading) => links.has(heading.id));

  // The last section whose heading has passed the upper third of the window.
  const update = () => {
    const current = headings.findLast((heading) => heading.getBoundingClientRect().top < innerHeight / 3);
    for (const [id, link] of links) link.toggleAttribute('data-current', id === current?.id);
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(36px, 5vw, 64px) clamp(32px, 6vw, 96px);
    width: var(--page);
    margin: 8px auto 0;
  }

  [data-tone='red'] {
    --tone: var(--red);
  }

  [data-tone='orange'] {
    --tone: var(--orange);
  }

  [data-tone='yellow'] {
    --tone: var(--yellow);
  }

  [data-tone='green'] {
    --tone: var(--green);
  }

  [data-tone='cyan'] {
    --tone: var(--cyan);
  }

  [data-tone='blue'] {
    --tone: var(--blue);
  }

  [data-tone='violet'] {
    --tone: var(--violet);
  }

  /* The page's name on its color, as the home page's bands are. It stays put between pages while its color changes. */
  .cover {
    grid-column: 1 / -1;
    display: grid;
    /* The name takes the room it needs, so a long one stays on its line. */
    grid-template-columns: auto minmax(13em, 1fr);
    align-items: end;
    gap: 20px clamp(28px, 5vw, 80px);
    min-height: clamp(210px, 27vw, 340px);
    padding: clamp(22px, 3.4vw, 44px);
    border-radius: var(--block);
    color: #000;
    background: var(--tone);
    view-transition-name: docs-cover;
  }

  .cover ::selection {
    color: #fff;
    background: #000;
  }

  .cover h1 {
    font-size: clamp(2rem, 7vw, 6rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
    overflow-wrap: break-word;
  }

  .cover p {
    justify-self: end;
    max-width: 24em;
    padding-bottom: 0.3em;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .sidebar > ul {
    position: sticky;
    top: calc(var(--nav-height) + 24px);
    display: grid;
    gap: 2px;
    max-height: calc(100svh - var(--nav-height) - 48px);
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    view-transition-name: docs-nav;
  }

  .sidebar a {
    position: relative;
    display: block;
    border-radius: 12px;
    color: var(--haze);
    text-decoration: none;
  }

  .sidebar a:hover {
    color: var(--ink);
  }

  /* A page and the dot of its color, like the dot in the corner of an effect's tile. */
  .sidebar > ul > li > a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
  }

  .sidebar > ul > li > a::before {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--tone);
  }

  .sidebar > ul > li > a:hover {
    background: var(--night-raised);
  }

  .sidebar a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    background: var(--night-raised);
  }

  /* The page's sections hang from its dot. */
  .sections {
    margin: 6px 0 12px 18.5px;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .sections a {
    padding: 5px 8px;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .sections a[data-current] {
    color: var(--ink);
  }

  /* The section being read is marked on the line, in the page's color. */
  .sections a[data-current]::before {
    content: '';
    position: absolute;
    inset: 4px auto 4px -15.5px;
    width: 2px;
    border-radius: 2px;
    background: var(--tone);
  }

  .guide {
    max-width: 760px;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 80px;
  }

  .pager a {
    display: grid;
    gap: 4px;
    padding: 20px 24px;
    border-radius: 24px;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: translate 0.4s var(--spring);
  }

  .pager span {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .previous {
    color: var(--ink);
    background: var(--night-raised);
  }

  .previous span {
    color: var(--haze);
  }

  .previous:hover {
    translate: -6px 0;
  }

  /* The next page is a tile of its own color. */
  .next {
    grid-column: 2;
    color: #000;
    background: var(--tone);
    text-align: right;
  }

  .next:hover {
    color: #000;
    translate: 6px 0;
  }

  .next:focus-visible {
    outline-color: var(--ink);
  }

  /* The pages become one row that scrolls sideways, above the page's name. */
  @media (max-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 0;
    }

    .cover {
      grid-template-columns: minmax(0, 1fr);
      align-content: end;
      border-radius: 24px;
    }

    .cover p {
      justify-self: start;
    }

    .sidebar {
      order: -1;
      margin: 0 calc(-1 * var(--gutter));
    }

    .sidebar > ul {
      position: static;
      display: flex;
      gap: 4px;
      max-height: none;
      padding: 0 var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .sidebar a {
      white-space: nowrap;
    }

    .sections {
      display: none;
    }

    .guide {
      margin-top: 16px;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .next {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pager a {
      transition: none;
    }
  }
</style>