---
import '../styles/global.css';
import { Font, Image, getImage } from 'astro:assets';
import logo from '../../../assets/UnishadeSmall.png';
import icon from '../../../assets/Unishade.ico?url';
import appIcon from '../../../assets/Unishade.png';
import banner from '../../../assets/brand/unishade-social.png';
import { links } from '../links';
import BookIcon from '../icons/book.svg';
import DiscordIcon from '../icons/discord.svg';
import GithubIcon from '../icons/github.svg';
import KofiIcon from '../icons/kofi.svg';
import MenuIcon from '../icons/menu.svg';

interface Props {
  title: string;
  description: string;
  // The home page lays its navigation over the hero, where it scrolls away with it, and its footer slides over the
  // last band.
  overlay?: boolean;
  // Keeps the page out of search results, like the 404 page, which Cloudflare shows at any address without a page.
  noindex?: boolean;
}

const { title, description, overlay = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Small icons for browser tabs and home screens. The .ico stays for older browsers.
const favicon = await getImage({ src: appIcon, width: 32, height: 32, format: 'png', layout: 'none' });
const touchIcon = await getImage({ src: appIcon, width: 180, height: 180, format: 'png', background: '#000000', layout: 'none' });
// The picture link previews show, which is made at their 1.91:1.
const preview = await getImage({ src: banner, width: 1200, height: 630, format: 'jpg', quality: 80, layout: 'none' });
const previewUrl = new URL(preview.src, Astro.site);
const previewAlt = 'The Unishade logo and name, and the words Universal post-processing without injection.';

// Discord shows this instead of the Open Graph preview. It drops the whole thing over 3,000 bytes or with a key it
// doesn't know, and falls back to Open Graph. https://docs.discord.com/developers/link-previews/component-embeds
const discordEmbed = {
  component: {
    type: 17, // Container
    accent_color: 0xffffff,
    components: [
      { type: 10, content: `### ${noindex ? title : `[${title}](${canonical})`}\n${description}` },
      { type: 12, items: [{ media: { url: previewUrl }, description: previewAlt }] },
      {
        type: 1,
        components: [
          { type: 2, style: 5, label: 'Download', url: new URL('/download/', Astro.site) },
          { type: 2, style: 5, label: 'Docs', url: new URL('/docs/', Astro.site) },
          { type: 2, style: 5, label: 'GitHub', url: links.github },
        ],
      },
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#000000" />
    <Font cssVariable="--font-bricolage" preload={[{ weight: 400 }, { weight: 800 }]} />
    <link rel="icon" href={icon} sizes="48x48" />
    <link rel="icon" href={favicon.src} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Unishade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(preview.attributes.width)} />
    <meta property="og:image:height" content={String(preview.attributes.height)} />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script id="discord:component-embed" type="application/json" set:html={JSON.stringify(discordEmbed)} />
  </head>
  <body>
    <header class:list={['nav', { overlay }]}>
      <a class="brand" href="/" aria-label="Unishade home">
        <Image src={logo} alt="" width={40} layout="fixed" loading="eager" class="brand-logo" />
        <span class="brand-name">Unishade</span>
      </a>
      <nav aria-label="Main">
        <ul id="nav-links">
          <li><a href="/docs/"><BookIcon aria-hidden="true" />Docs</a></li>
          <li><a href={links.discord}><DiscordIcon aria-hidden="true" />Discord</a></li>
          <li><a href={links.github}><GithubIcon aria-hidden="true" />GitHub</a></li>
          <li><a class="kofi" href={links.kofi}><KofiIcon aria-hidden="true" />Ko-fi</a></li>
        </ul>
        <a class="button button-primary" href="/download/">Download</a>
        <button class="menu-button" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
          <MenuIcon aria-hidden="true" />
        </button>
      </nav>
    </header>

    <script>
      const nav = document.querySelector<HTMLElement>('.nav')!;
      const update = () => nav.classList.toggle('scrolled', window.scrollY > 0);
      addEventListener('scroll', update, { passive: true });
      update();

      // On narrow screens the links fold into a menu.
      const button = nav.querySelector<HTMLButtonElement>('.menu-button')!;
      const open = (value: boolean) => {
        button.setAttribute('aria-expanded', String(value));
        nav.classList.toggle('menu-open', value);
      };
      button.addEventListener('click', () => open(!nav.classList.contains('menu-open')));
      addEventListener('click', (event) => {
        if (!nav.contains(event.target as Node)) open(false);
      });
      addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !nav.classList.contains('menu-open')) return;
        open(false);
        button.focus();
      });
    </script>

    <slot />

    <footer class:list={['footer', { overlay }]}>
      <div class="footer-about">
        <a class="brand" href="/">
          <Image src={logo} alt="" width={56} layout="fixed" class="footer-logo" />
          Unishade
        </a>
        <p>Free and open source, under the <a href={links.license}>MIT license</a>.</p>
        <a class="button button-primary" href="/download/">Download Unishade</a>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <div>
          <h2>Unishade</h2>
          <a href="/download/">Download</a>
          <a href="/docs/">Docs</a>
          <a href="/docs/troubleshooting/">Troubleshooting</a>
          <a href={links.releases}>Releases</a>
          <a href="/branding/">Branding</a>
        </div>
        <div>
          <h2>Community</h2>
          <a href={links.discord}>Discord</a>
          <a href={links.github}>GitHub</a>
          <a href={links.kofi}>Ko-fi</a>
        </div>
        <div>
          <h2>Legal</h2>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href="/cookies/">Cookies</a>
          <a href="/code-signing/">Code signing</a>
        </div>
      </nav>
      <p class="footer-small">
        © {new Date().getFullYear()} Unishade contributors. Effects are written for <a href={links.reshade}>ReShade</a> by crosire. Unishade isn't
        affiliated with the games it runs on.
      </p>
      <p class="wordmark" aria-hidden="true">Unishade</p>
    </footer>
  </body>
</html>

<style>
  /* Spans the window so the background does too, with the links on the page's edges. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--nav-height);
    padding: 0 var(--gutter);
    view-transition-name: nav;
    transition: background-color 0.25s;
  }

  .nav.scrolled {
    background-color: rgb(0 0 0 / 0.78);
    backdrop-filter: blur(18px) saturate(1.4);
  }

  .nav.overlay {
    position: absolute;
    inset: 0 0 auto;
  }

  .nav .button {
    min-height: 44px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-logo {
    width: 40px;
    height: auto;
  }

  .nav nav,
  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.6vw, 32px);
  }

  .nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav li {
    display: flex;
  }

  .nav nav a:not(.button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .nav nav a:not(.button):hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .nav svg {
    width: 19px;
    height: 19px;
  }

  .kofi svg {
    color: #ff5e5b;
  }

  .menu-button {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--ink);
    background: var(--night-high);
    cursor: pointer;
  }

  /* The launcher's black, with the name in the ring's colors as wide as the window and cut off by its bottom edge. */
  .footer {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px clamp(32px, 6vw, 96px);
    margin-top: clamp(96px, 12vw, 160px);
    padding: clamp(56px, 7vw, 96px) var(--gutter) 0;
    overflow: hidden;
    border-top: 1px solid var(--line);
    color: var(--haze);
    background: var(--night);
  }

  /* The last thing to slide over the home page's bands. */
  .footer.overlay {
    margin-top: -35px;
    border-top: 0;
    border-radius: var(--block) var(--block) 0 0;
  }

  .footer-about {
    display: grid;
    gap: 18px;
    align-content: start;
    justify-items: start;
    max-width: 24em;
    font-size: 1.1rem;
  }

  .footer .brand {
    gap: 14px;
    font-size: 1.6rem;
  }

  .footer-logo {
    width: 56px;
    height: auto;
  }

  .footer a:not(.button, .brand) {
    color: inherit;
  }

  .footer a:not(.button, .brand):hover {
    color: #fff;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 32px clamp(36px, 6vw, 88px);
  }

  .footer-links div {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .footer-links h2 {
    margin-bottom: 4px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-small {
    grid-column: 1 / -1;
    font-size: 0.92rem;
  }

  .wordmark {
    grid-column: 1 / -1;
    /* The colors only fill the box, which the line height makes shorter than the dot of the i. The padding makes room
       for it, and the margin takes that room back. */
    margin: -0.1em -0.04em -0.17em;
    padding-top: 0.1em;
    color: transparent;
    background: linear-gradient(90deg, var(--spectrum));
    background-clip: text;
    font-size: 21.6vw;
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    user-select: none;
  }

  @media (max-width: 800px) {
    .nav nav {
      gap: 10px;
    }

    .menu-button {
      display: grid;
    }

    /* The links drop down under the bar, at its right edge. */
    .nav ul {
      position: absolute;
      top: calc(var(--nav-height) - 8px);
      right: var(--gutter);
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      min-width: 210px;
      padding: 8px;
      border-radius: 24px;
      background: var(--night-raised);
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.12),
        0 20px 50px rgb(0 0 0 / 0.5);
    }

    .menu-open ul {
      display: flex;
    }

    .nav ul a:not(.button) {
      display: flex;
      padding: 10px 14px;
      border-radius: 16px;
    }

    .nav ul a:not(.button):hover {
      background: var(--night-high);
      text-decoration: none;
    }

    .footer {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer.overlay {
      margin-top: 0;
    }

    .footer-links {
      grid-template-columns: repeat(2, auto);
      justify-content: start;
    }
  }

  @media (max-width: 440px) {
    .brand-name {
      display: none;
    }
  }
</style>
