---
import Base from './Base.astro';

// The Markdown pages in src/pages that use this layout pass their frontmatter.
interface Props {
  frontmatter: { title: string; description: string; updated: string };
}

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} | Unishade`} description={frontmatter.description}>
  <main class="legal">
    <header>
      <h1>{frontmatter.title}</h1>
      <p class="dim">Last updated {frontmatter.updated}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </main>
</Base>

<style>
  .legal {
    width: min(760px, 100% - 2 * var(--gutter));
    margin: clamp(40px, 7vw, 88px) auto 0;
  }

  header {
    display: grid;
    gap: 14px;
    margin-bottom: 44px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
  }
</style>
