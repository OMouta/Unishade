---
import { Image } from 'astro:assets';
import DownloadButton from './DownloadButton.astro';
import before from '../assets/compare-before.png';
import after from '../assets/compare-after.png';
---

<!-- Laid out like the logo: the game is the cube, and the ring goes round it. The after picture shows right of the line. -->
<section class="hero">
  <div class="hero-text">
    <h1><span>Universal</span> <span>post-processing</span> <span>without injection.</span></h1>
    <p class="lede">Built for games where traditional ReShade injection isn't available or desirable. Formerly RobloxShadeHost.</p>
    <DownloadButton detect />
  </div>

  <div class="stage">
    <div class="orbit" aria-hidden="true">
      <div class="ring glow"><i></i></div>
      <div class="ring"><i></i></div>
    </div>

    <div class="game">
      <Image src={before} widths={[800, 1400, 1920]} sizes="(max-width: 1280px) 100vw, 1180px" alt="A game without effects" class="shot" priority />
      <Image src={after} widths={[800, 1400, 1920]} sizes="(max-width: 1280px) 100vw, 1180px" alt="The same scene with Unishade's effects" class="shot after" priority />

      <input class="compare-range" type="range" min="0" max="100" value="50" aria-label="Compare before and after" />
      <div class="compare-line" aria-hidden="true">
        <span class="compare-handle"><span>Before</span><span class="compare-grip"></span><span>After</span></span>
      </div>

      <!-- The near half of the ring passes in front of the game. -->
      <div class="orbit orbit-front" aria-hidden="true">
        <div class="ring glow"><i></i></div>
        <div class="ring"><i></i></div>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero .game')!;
  const afterShot = hero.querySelector<HTMLImageElement>('.after')!;
  const range = hero.querySelector<HTMLInputElement>('.compare-range')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
  const ease = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - (-2 * p + 2) ** 3 / 2);
  const rest = 0.5;

  // Once the after picture has loaded, the line crosses from the right and the effects come on behind it.
  let sweep: number | undefined;
  let split = still ? rest : 1;
  let target = split;
  let frame = 0;
  let last = 0;

  const place = () => {
    hero.style.setProperty('--split', `${split * 100}%`);
    range.value = String(Math.round(target * 100));
  };

  const tick = (now: number) => {
    frame = 0;
    const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
    last = now;
    if (sweep !== undefined) {
      sweep ||= now;
      const p = clamp((now - sweep) / 1500);
      split = target = 1 - (1 - rest) * ease(p);
      if (p === 1) sweep = undefined;
    } else if (still) {
      split = target;
    } else {
      split += (target - split) * (1 - Math.exp(-dt * 16));
    }
    place();
    if (sweep !== undefined || Math.abs(target - split) > 0.0005) frame = requestAnimationFrame(tick);
    else last = 0;
  };

  const draw = () => {
    if (!frame) frame = requestAnimationFrame(tick);
  };

  const moveTo = (value: number) => {
    sweep = undefined;
    target = value;
    draw();
  };

  place();
  if (!still) {
    const start = () =>
      setTimeout(() => {
        if (target !== 1) return;
        sweep = 0;
        draw();
      }, 900);
    if (afterShot.complete) start();
    else afterShot.addEventListener('load', start, { once: true });
  }

  // A mouse moves the line from the first press. A finger has to move sideways first, so it can still scroll.
  const share = (event: PointerEvent) => clamp((event.clientX - hero.getBoundingClientRect().left) / hero.clientWidth);
  let dragging: number | undefined;
  let pending: { id: number; x: number; y: number } | undefined;

  hero.addEventListener('pointerdown', (event) => {
    if (event.button !== 0 || (event.target as Element).closest('a, button, input')) return;
    if (event.pointerType === 'mouse') {
      event.preventDefault();
      dragging = event.pointerId;
      hero.setPointerCapture(event.pointerId);
      moveTo(share(event));
    } else {
      pending = { id: event.pointerId, x: event.clientX, y: event.clientY };
    }
  });

  hero.addEventListener('pointermove', (event) => {
    if (pending?.id === event.pointerId) {
      const dx = Math.abs(event.clientX - pending.x);
      const dy = Math.abs(event.clientY - pending.y);
      if (dx > 8 && dx > dy) {
        dragging = event.pointerId;
        hero.setPointerCapture(event.pointerId);
        pending = undefined;
      } else if (dy > 8) {
        pending = undefined;
      }
    }
    if (dragging === event.pointerId) moveTo(share(event));
  });

  hero.addEventListener('pointerup', (event) => {
    // A tap moves the line there.
    if (pending?.id === event.pointerId) moveTo(share(event));
    pending = undefined;
    dragging = undefined;
  });

  hero.addEventListener('pointercancel', () => {
    pending = undefined;
    dragging = undefined;
  });

  range.addEventListener('input', () => moveTo(Number(range.value) / 100));
</script>

<style>
  .hero {
    position: relative;
    padding: calc(var(--nav-height) + clamp(36px, 8svh, 96px)) 0 clamp(96px, 13vw, 200px);
    /* The ring is wider than the window on small screens. */
    overflow-x: clip;
  }

  .hero-text {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 26px;
    justify-items: center;
    width: var(--page);
    margin: 0 auto;
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 6.3vw, 6.4rem);
    font-weight: 860;
    line-height: 0.94;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  .lede {
    color: var(--haze);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }

  .hero-text :global(.download) {
    justify-content: center;
    margin-top: 6px;
  }

  /* The version and size go on their own line, under the button. */
  .hero-text :global(.download > .dim) {
    flex-basis: 100%;
  }

  .stage {
    position: relative;
    width: min(1180px, 100% - 2 * var(--gutter));
    margin: clamp(72px, 9vw, 132px) auto 0;
  }

  .game {
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: clamp(10px, 1.4vw, 18px);
    background: var(--night-raised);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.14),
      0 50px 120px -30px #000;
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }

  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .after {
    clip-path: inset(0 0 0 var(--split, 50%));
  }

  /* A square around the middle of the game, turned like the logo's ring. The whole ring goes behind the game, and the
     game draws the near half again over itself. */
  .orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 138%;
    aspect-ratio: 1;
    translate: -50% -50%;
    rotate: -11deg;
    scale: 1 0.5;
    pointer-events: none;
    animation: open 1.5s 0.15s var(--ease-out) backwards;
  }

  .orbit-front {
    z-index: 2;
    clip-path: inset(50% 0 0);
    mix-blend-mode: screen;
  }

  /* Starts as a line of light and opens into the ring. */
  @keyframes open {
    from {
      scale: 0.7 0.004;
      opacity: 0;
    }

    25% {
      opacity: 1;
    }
  }

  /* The blur is on the element that turns, so the browser draws it once. */
  .ring {
    position: absolute;
    inset: 0;
    animation: turn 48s linear infinite;
  }

  .ring.glow {
    filter: blur(26px) saturate(1.3);
    opacity: 0.9;
  }

  .ring i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(var(--spectrum), #ff4860);
    mask-image: radial-gradient(closest-side, transparent 95.4%, #000 96.6%, #000 98.8%, transparent 100%);
  }

  .ring.glow i {
    mask-image: radial-gradient(closest-side, transparent 91%, #000 94%, #000 99%, transparent 100%);
  }

  /* White in the middle of the tube, like the logo's. */
  .ring:not(.glow) i::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #fff;
    mask-image: radial-gradient(closest-side, transparent 97%, #000 97.6%, #000 97.8%, transparent 98.4%);
    opacity: 0.8;
  }

  @keyframes turn {
    to {
      rotate: -1turn;
    }
  }

  .compare-line {
    position: absolute;
    z-index: 3;
    inset: 0 auto 0 var(--split, 50%);
    width: 2px;
    margin-left: -1px;
    background: linear-gradient(to bottom, var(--spectrum));
    pointer-events: none;
  }

  .compare-line::before {
    content: '';
    position: absolute;
    inset: 0 -5px;
    background: inherit;
    filter: blur(10px);
    opacity: 0.8;
  }

  .compare-handle {
    position: absolute;
    bottom: 12%;
    left: 50%;
    /* Equal columns either side keep the grip on the line, though "Before" is wider than "After". */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    color: var(--ink);
    background: rgb(0 0 0 / 0.62);
    backdrop-filter: blur(12px);
    font-size: 0.82rem;
    font-weight: 650;
    font-stretch: 112%;
    line-height: 1;
    white-space: nowrap;
    width: max-content;
    transform: translateX(-50%);
  }

  .compare-handle > :first-child {
    justify-self: end;
  }

  .compare-grip {
    width: 2px;
    height: 18px;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--spectrum));
  }

  /* The keyboard moves the line through this, and the handle shows its focus. */
  .compare-range {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .compare-range:focus-visible + .compare-line .compare-handle {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 9.6vw;
      font-stretch: 104%;
    }

    .compare-handle {
      padding: 6px 10px;
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .ring {
      animation: none;
    }
  }
</style>
