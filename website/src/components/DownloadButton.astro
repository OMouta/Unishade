---
import { megabytes, release, type Download } from '../release';
import { requirements } from '../site';

interface Props {
  // Offers macOS and Linux visitors their own download. Use it on the page's main button only.
  detect?: boolean;
}

const { detect = false } = Astro.props;

// The line under the button: the version, the file's size and what it runs on.
const details = (file: Download | undefined, runsOn: string) =>
  [file?.name && release.version && `Version ${release.version}`, file?.size && megabytes(file.size), runsOn]
    .filter(Boolean)
    .join(' · ');

const windows = {
  label: release.setup.name ? 'Download for Windows' : 'Download from GitHub Releases',
  href: release.setup.url,
  details: details(release.setup, requirements.windowsShort),
  other: { label: 'macOS and Linux', href: '/download/#macos-and-linux' },
};

// When the newest release has no file for them, macOS and Linux visitors go to the download page, which says why.
const platforms = {
  macos: {
    label: release.macos ? 'Download for macOS' : 'Unishade for macOS',
    href: release.macos?.url ?? '/download/#macos-and-linux',
    details: `Experimental · ${details(release.macos, requirements.macosShort)}`,
    other: { label: 'Other platforms', href: '/download/' },
  },
  linux: {
    label: release.linux ? 'Download for Linux' : 'Unishade for Linux',
    href: release.linux?.url ?? '/download/#macos-and-linux',
    details: `Experimental · ${details(release.linux, requirements.linuxShort)}`,
    other: { label: 'Other platforms', href: '/download/' },
  },
};
---

<div class="download" data-platforms={detect ? JSON.stringify(platforms) : undefined}>
  <a class="button button-primary" href={windows.href}>{windows.label}</a>
  <!-- Another button can go next to this one. -->
  <slot />
  <span class="dim">
    <span class="details">{windows.details}</span> · <a class="other" href={windows.other.href}>{windows.other.label}</a>
  </span>
</div>

<script>
  // Swaps in the macOS or Linux download. Everyone else, and browsers without scripts, get Windows.
  interface Platform {
    label: string;
    href: string;
    details: string;
    other: { label: string; href: string };
  }

  const platform = (navigator as Navigator & { userAgentData?: { platform: string } }).userAgentData?.platform ?? navigator.platform;
  // iPads say they're Macs, but have a touch screen.
  const os =
    /^mac/i.test(platform) && navigator.maxTouchPoints < 2
      ? 'macos'
      : /linux/i.test(platform) && !/android/i.test(navigator.userAgent)
        ? 'linux'
        : undefined;

  for (const element of document.querySelectorAll<HTMLElement>('.download[data-platforms]')) {
    const choice = os && (JSON.parse(element.dataset.platforms!) as Record<string, Platform>)[os];
    if (!choice) continue;
    const button = element.querySelector<HTMLAnchorElement>('.button')!;
    const other = element.querySelector<HTMLAnchorElement>('.other')!;
    button.href = choice.href;
    button.textContent = choice.label;
    element.querySelector('.details')!.textContent = choice.details;
    other.href = choice.other.href;
    other.textContent = choice.other.label;
  }
</script>

<style>
  .download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }
</style>
