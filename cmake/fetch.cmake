# Third-party files are downloaded once at configure time instead of being vendored. The download gets its final name
# only after its hash matched, since CMake keeps a file that failed the check.
function(fetch_file url hash destination)
    if(NOT EXISTS "${destination}")
        file(REMOVE "${destination}.part")
        file(DOWNLOAD "${url}" "${destination}.part" EXPECTED_HASH "SHA256=${hash}" STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${destination}.part")
            list(GET status 1 message)
            message(FATAL_ERROR "Could not download ${url}: ${message}")
        endif()
        file(RENAME "${destination}.part" "${destination}")
    endif()
endfunction()

# A few lines of downloaded sources are changed, in copies under patched/ beside them, and configuring stops if a line
# is no longer there, so an update cannot drop a change unnoticed. Takes the folder, the file's name, then pairs of
# the old text and the new.
function(patch_source directory name)
    file(READ "${directory}/${name}" source)
    math(EXPR last "${ARGC} - 1")
    foreach(index RANGE 2 ${last} 2)
        math(EXPR next "${index} + 1")
        set(old "${ARGV${index}}")
        set(new "${ARGV${next}}")
        string(FIND "${source}" "${old}" at)
        if(at EQUAL -1)
            message(FATAL_ERROR "${directory}/${name} changed. Update its patch in ${CMAKE_CURRENT_LIST_FILE}.")
        endif()
        string(REPLACE "${old}" "${new}" source "${source}")
    endforeach()
    set(patched "${directory}/patched/${name}")
    set(existing "")
    if(EXISTS "${patched}")
        file(READ "${patched}" existing)
    endif()
    if(NOT existing STREQUAL source)
        file(WRITE "${patched}" "${source}")
    endif()
endfunction()
