// Unishade.exe's icon, which the notification area shows too.
1 ICON "../../../assets/Unishade.ico"

#include <winver.h>

1 VERSIONINFO
 FILEVERSION UNISHADE_VERSION_RESOURCE
 PRODUCTVERSION UNISHADE_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef UNISHADE_BETA
 FILEFLAGS VS_FF_PRERELEASE
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Unishade contributors\0"
            VALUE "FileDescription", "Unishade\0"
            VALUE "FileVersion", UNISHADE_VERSION "\0"
            VALUE "InternalName", "Unishade\0"
            VALUE "OriginalFilename", "Unishade.exe\0"
            VALUE "ProductName", "Unishade\0"
            VALUE "ProductVersion", UNISHADE_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
