#include "resource.h"

1 ICON "../assets/Unishade.ico"
IDR_LOGO RCDATA "../assets/Unishade.png"
IDR_FFX_A RCDATA FFX_A_HEADER
IDR_FFX_FSR1 RCDATA FFX_FSR1_HEADER

#include <winver.h>

1 VERSIONINFO
 FILEVERSION UNISHADE_VERSION_RESOURCE
 PRODUCTVERSION UNISHADE_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DSL MODS\0"
            VALUE "FileDescription", "DSL MODS Visual Engine\0"
            VALUE "FileVersion", UNISHADE_VERSION "\0"
            VALUE "InternalName", "DSL MODS Visual Engine\0"
            VALUE "OriginalFilename", "Unishade.exe\0"
            VALUE "ProductName", "DSL MODS Visual Engine\0"
            VALUE "ProductVersion", UNISHADE_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
