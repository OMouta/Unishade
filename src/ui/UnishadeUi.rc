#include <winver.h>

1 VERSIONINFO
 FILEVERSION UNISHADE_VERSION_RESOURCE
 PRODUCTVERSION UNISHADE_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Unishade contributors\0"
            VALUE "FileDescription", "Unishade window\0"
            VALUE "FileVersion", UNISHADE_VERSION "\0"
            VALUE "InternalName", "UnishadeUi\0"
            VALUE "OriginalFilename", "UnishadeUi.dll\0"
            VALUE "ProductName", "Unishade\0"
            VALUE "ProductVersion", UNISHADE_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
